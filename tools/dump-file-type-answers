#!/bin/sh
# Regenerates file_type_answers() in tests/testthat/helper-file-type.R:
# file-type's own answers on its fixture/ directory, from the version that
# matches FILE_TYPE_COMMIT in tools/fetch-fixtures. Needs Node, npm and the
# fixtures (tools/fetch-fixtures). Run it after bumping FILE_TYPE_COMMIT,
# with FILE_TYPE_VERSION set to that commit's release.
#
#   tools/dump-file-type-answers
#
# Run from the package root.
set -eu

FILE_TYPE_VERSION=${FILE_TYPE_VERSION:-22.2.0}
fixtures=tests/testthat/fixtures/file-type
helper=tests/testthat/helper-file-type.R

if [ ! -f "$fixtures/COMMIT" ]; then
  echo "no fixtures in $fixtures; run tools/fetch-fixtures" >&2
  exit 1
fi
commit=$(cut -c1-7 "$fixtures/COMMIT")

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
npm install --silent --no-audit --no-fund --prefix "$tmp" \
  "file-type@$FILE_TYPE_VERSION" >/dev/null

cat > "$tmp/dump.mjs" <<'JS'
import {readdirSync, readFileSync, writeFileSync} from 'node:fs';
import {join} from 'node:path';
import {fileTypeFromFile} from 'file-type';

const [fixtures, helper, version, commit] = process.argv.slice(2);
const files = readdirSync(fixtures).filter(f => f !== 'COMMIT').sort();
const answers = [];
for (const file of files) {
  const t = await fileTypeFromFile(join(fixtures, file));
  if (t) answers.push([file, t.mime.split(';')[0].trim()]);
}
const quote = xs => xs.map(x => `      ${JSON.stringify(x)}`).join(',\n');
const block = `# file-type ${version}'s own answers on its fixture/ directory at commit ${commit}
# (design section 7.3): fileTypeFromFile() run once with Node over every
# fixture, keeping the essence it reported. sindresorhus/file-type is MIT.
# Fixtures it does not answer are left out. Generated by
# tools/dump-file-type-answers; do not edit by hand.
file_type_answers <- function() {
  data.frame(
    file = c(
${quote(answers.map(a => a[0]))}
    ),
    mime = c(
${quote(answers.map(a => a[1]))}
    )
  )
}
`;
const text = readFileSync(helper, 'utf8');
const end = text.indexOf('\n}\n') + 3;
writeFileSync(helper, block + text.slice(end));
console.log(`${answers.length} answers from file-type ${version}`);
JS

NODE_PATH="$tmp/node_modules" node "$tmp/dump.mjs" "$fixtures" "$helper" \
  "$FILE_TYPE_VERSION" "$commit"
